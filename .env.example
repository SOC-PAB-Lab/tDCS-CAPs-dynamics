# ============================================================
# tDCS-CAPs-dynamics – path configuration
# Copy this file to .env and fill in your local paths
# ============================================================

# Root output directory – coactivation_patterns_run-ON/ will be created here
BASE_DIR=

# Directory containing preprocessed/denoised fMRI volumes
# Expected filename pattern: sub-{sub}_ses-{ses}_run-{run}_denoised_simple.nii.gz
INPUT_DIR=

# Directory where per-subject downsampled ROI timeseries (.npy) files are saved
# Expected filename pattern: sub-{sub}_ses-{ses}_run-{run}_1060-ROIs_timeseries.npy
DOWNSAMPLED_TS_DIR=

# Directory containing the KH atlas files:
#   atlas_combined_tpl-MNI152NLin2009cAsym_res-02_T1w.nii.gz
#   atlas_combined_labels.csv
ATLAS_DIR=

# Directory where result figures are saved
# Subdirectories used: main_figures/ and supplementary_figures/
RESULTS_DIR=

# fsaverage5 surface directory (FreeSurfer subject folder)
# Must contain: label/lh.cortex.label  and  label/rh.cortex.label
FSAVG_DIR=

# Anonymized behavioral data directory
BEH_DATA_ANON_DIR=